# Public canonical URL; set to your Vercel production domain.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
# Create a bot with BotFather; this is a secret and must stay server-side.
TELEGRAM_BOT_TOKEN=
# Numeric recipient chat ID. @limyrqq is a public contact, not a bot recipient ID.
TELEGRAM_CHAT_ID=
# disabled | telegram. Set telegram when both credentials are configured.
NOTIFICATION_ADAPTER=disabled
# Local: json. Vercel: memory (ephemeral; Telegram is the delivery record).
# Add a persistent adapter before relying on an in-app lead archive.
DATABASE_ADAPTER=json
# Production requires a shared Redis-compatible REST limiter; e.g. Upstash.
RATE_LIMIT_REST_URL=
RATE_LIMIT_REST_TOKEN=
# Future providers are disabled until adapters are implemented.
PAYMENTS_PROVIDER=disabled
PAYMENTS_SECRET_KEY=
PAYMENTS_WEBHOOK_SECRET=
AUTH_PROVIDER=disabled
AUTH_SECRET=
ANALYTICS_PROVIDER=disabled
NEXT_PUBLIC_ANALYTICS_ID=
